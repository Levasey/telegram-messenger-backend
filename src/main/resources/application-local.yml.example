# Скопируйте в application-local.yml (файл в .gitignore) и подставьте токен от @BotFather.
# Профиль local включает in-memory H2, H2 Console и ddl-auto: update (см. application.yml).
# Запуск: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
# или: export SPRING_PROFILES_ACTIVE=local

telegram:
  bot:
    token: "YOUR_BOT_TOKEN_FROM_BOTFATHER"
    # Секрет webhook (тот же, что в setWebhook secret_token); или TELEGRAM_WEBHOOK_SECRET
    # webhook-secret-token: "случайная_строка_1_256_символов"
    # welcome-message: "Свой текст, плейсхолдер {name}"
